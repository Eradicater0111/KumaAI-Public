# KUMA Bootstrap-A known-good environment contract.
#
# Supported major/minor lines are intentionally narrower than the observed
# patch versions. Patch upgrades remain eligible for validation without
# silently changing the supported interpreter family.
#
# BOOTSTRAP != RUNTIME AUTHORITY
# ENVIRONMENT DETECTION != EXECUTION AUTHORIZATION
# AUTHORITY:NONE

KUMA_MAIN_PYTHON_SERIES=3.14
KUMA_MAIN_PYTHON_KNOWN_GOOD=3.14.6

KUMA_VOICE_PYTHON_SERIES=3.12
KUMA_VOICE_PYTHON_KNOWN_GOOD=3.12.14
